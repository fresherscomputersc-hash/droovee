# Copy to .env.local (or set these in Vercel).
# API origin used by the Next.js rewrite and the middleware fallback check.
API_TARGET=http://127.0.0.1:4000
# Server-only. Must be the same value as the API's JWT_ACCESS_SECRET.
# When set, /admin/* middleware verifies the access JWT locally instead of
# calling /auth/me on every page load. Never expose this with NEXT_PUBLIC_.
# JWT_ACCESS_SECRET=
