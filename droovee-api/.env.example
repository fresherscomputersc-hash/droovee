# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=4000
# MongoDB Atlas (replica set required for transactions).
# Local:  mongodb://127.0.0.1:27017/droovee?replicaSet=rs0&directConnection=true
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/droovee?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/droovee
# Required in EVERY environment (no fallbacks). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-32-chars-minimum
TOKEN_PEPPER=change-me-random-pepper
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# --- Production / hosting ---
# Public web URL, used for password-reset links in emails.
# WEB_URL=https://droovee.in
# --- Outgoing email (booking confirmations + password resets) ---
# Free option: Gmail App Password (Google account → 2-Step Verification →
# App passwords → "Mail"). Never commit real values.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=Droovee <you@gmail.com>
# When SMTP_* is unset, emails are logged and skipped — bookings still succeed.
# OTP code in API responses. Keep UNSET (or anything but "true") everywhere
# except local testing — otherwise anyone knowing a phone number reads its code.
# OTP_DEBUG=true
# Cookie SameSite. Default "lax" is correct when the web app proxies /api/*
# (browser sees one domain). Only set "none" if browsers call the API
# cross-origin directly (then Secure is forced on automatically).
# COOKIE_SAMESITE=lax
# Milliseconds a revoked refresh token may be re-presented before it counts
# as theft (benign double-submit grace). Default 10000.
# REFRESH_REUSE_GRACE_MS=10000
# Production starts with Mongoose autoIndex disabled. Run this once after a
# schema/index change: npm run db:indexes
