# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=4000
# MongoDB Atlas (replica set required for transactions).
# Local:  mongodb://127.0.0.1:27017/droovee?replicaSet=rs0&directConnection=true
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/droovee?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/droovee
# Required in EVERY environment (no fallbacks). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-32-chars-minimum
TOKEN_PEPPER=change-me-random-pepper
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Enable OTP sign-in and mobile verification. In production this requires Wakit.
OTP_ENABLED=false
# --- WhatsApp OTP via Wakit (https://wakit.in/docs) ---
# Wakit generates the code, sends it on WhatsApp, and verifies it by message id.
# Required when OTP_ENABLED=true in production. Use wk_test_ keys to simulate;
# wk_live_ keys send real WhatsApp messages and debit the Wakit balance.
# WAKIT_API_KEY=wk_live_xxxxxxxxxxxxxxxxxxxx
# WAKIT_BASE_URL=https://wakit.in/api/v1
# WAKIT_TIMEOUT_MS=10000
# Optional. Defaults to "wakit" when WAKIT_API_KEY is set. Set "local" only for
# offline development with OTP_DEBUG=true (Droovee-generated code, no delivery).
# OTP_PROVIDER=wakit
# --- Production / hosting ---
# Public web URL, used for password-reset links in emails.
# WEB_URL=https://droovee.in
# --- Outgoing email (booking confirmations + password resets) ---
# Free option: Gmail App Password (Google account → 2-Step Verification →
# App passwords → "Mail"). Never commit real values.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=Droovee <you@gmail.com>
# When SMTP_* is unset, emails are logged and skipped — bookings still succeed.
# Owner alert: every new CUSTOMER booking is sent to this WhatsApp number via
# Wakit (same API key as OTP). E.164 format, e.g. +919876543210.
# WAKIT_API_KEY must be set. Leave empty to fall back to ADMIN_NOTIFY_EMAIL.
# ADMIN_WHATSAPP_NUMBER=+919876543210
# Optional approved Wakit template for the alert. Without it the alert is
# free-form text, which Meta only delivers if the owner messaged the business
# number in the last 24 hours. Create the template with POST /templates, then
# set its name here. Params, in order, are: booking number, service type,
# scheduled pickup (IST), customer "name (phone)", total, admin console link.
# WAKIT_BOOKING_TEMPLATE=new_booking_alert
# WAKIT_BOOKING_TEMPLATE_LANG=en
# Legacy owner inbox, used only when ADMIN_WHATSAPP_NUMBER is empty (default
# droovee.admin@gmail.com). Set to "" to switch the email alert off.
# ADMIN_NOTIFY_EMAIL=droovee.admin@gmail.com
# The alert's "Open in Admin Console" link is built from WEB_URL, so set it too:
# WEB_URL=https://droovee.in
# OTP code in API responses. Keep UNSET (or anything but "true") everywhere
# except local testing — otherwise anyone knowing a phone number reads its code.
# OTP_DEBUG=true
# Cookie SameSite. Default "lax" is correct when the web app proxies /api/*
# (browser sees one domain). Only set "none" if browsers call the API
# cross-origin directly (then Secure is forced on automatically).
# COOKIE_SAMESITE=lax
# Milliseconds a revoked refresh token may be re-presented before it counts
# as theft (benign double-submit grace). Default 10000.
# REFRESH_REUSE_GRACE_MS=10000
# Production starts with Mongoose autoIndex disabled. Run this once after a
# schema/index change: npm run db:indexes
